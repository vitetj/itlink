---
/**
 * Squelette HTML commun à toutes les pages hors /docs (Starlight a le sien, habillé à l'identique).
 */
import '@/styles/global.css';
import { Font } from 'astro:assets';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SEO from '@/components/SEO.astro';
import { SITE } from '@/data/site';
import type { SeoInput } from '@/lib/seo';

interface Props {
  seo: SeoInput;
  /** Schémas JSON-LD à injecter (un `<script>` par objet). */
  jsonLd?: Record<string, unknown>[] | undefined;
  /** Teinte contextuelle de la page (liens actifs, cartes…). */
  hue?: 'docs' | 'blog' | 'lab' | 'travel' | 'accent' | undefined;
  /** Classe(s) ajoutée(s) à `<body>`. */
  bodyClass?: string | undefined;
}

const { seo, jsonLd = [], hue, bodyClass } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} class:list={[hue && `hue-${hue}`]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Applique le thème mémorisé avant le premier rendu (même clé que Starlight). */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('starlight-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch {}
      })();
    </script>
    <SEO {...seo} />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-plex-mono" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — tout le site`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f4ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e1116" />
    <meta name="generator" content={Astro.generator} />
    {jsonLd.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <slot name="head" />
  </head>
  <body class:list={['flex min-h-dvh flex-col', bodyClass]}>
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    background: var(--c-accent);
    color: var(--c-accent-fg);
    font-weight: 600;
    transition: top 120ms ease;
  }
  .skip-link:focus {
    top: 0.75rem;
  }
</style>
