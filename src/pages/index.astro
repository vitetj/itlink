---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import CardGrid from '@/components/CardGrid.astro';
import Icon from '@/components/Icon.astro';
import LevelBadge from '@/components/LevelBadge.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/data/site';
import {
  getAllCards,
  getDocCategoriesWithCounts,
  getDocs,
  getLab,
  getPosts,
  getTravel,
  docToCard,
  labToCard,
  postToCard,
  travelToCard,
} from '@/lib/content';
import { personJsonLd, websiteJsonLd } from '@/lib/seo';

const [cards, docs, categories, lab, posts, travel] = await Promise.all([
  getAllCards(),
  getDocs(),
  getDocCategoriesWithCounts(),
  getLab(),
  getPosts(),
  getTravel(),
]);

const latest = cards.slice(0, 6);
const popularDocs = [...docs.filter((d) => d.data.featured), ...docs.filter((d) => !d.data.featured)].slice(0, 6).map(docToCard);
const latestLab = lab.slice(0, 3).map(labToCard);
const latestPosts = posts.slice(0, 4).map(postToCard);
const latestTravel = travel.slice(0, 2).map(travelToCard);
const counts = { docs: docs.length, blog: posts.length, lab: lab.length, voyages: travel.length };
---

<BaseLayout
  seo={{ title: SITE.name, description: SITE.description, image: '/og/accueil.png', imageAlt: `${SITE.name} — ${SITE.author.role}` }}
  jsonLd={[websiteJsonLd(), { '@context': 'https://schema.org', ...personJsonLd() }]}
>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative grid gap-10 py-14 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] md:items-center md:py-20">
      <div>
        <h1 class="font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-6xl">{SITE.name}</h1>
        <p class="mt-3 font-mono text-sm text-fg-muted md:text-base">{SITE.author.role}</p>
        <p class="mt-6 max-w-xl text-lg text-fg md:text-xl text-pretty">
          15 ans passés dans l'IT.<br />
          Voici les notes que j'aurais aimé trouver quand ça ne fonctionnait pas.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/docs" class="btn btn-primary"><Icon name="book" size={18} /> Explorer les docs</a>
          <a href="/blog" class="btn"><Icon name="pen" size={18} /> Derniers articles</a>
        </div>
      </div>

      <div class="terminal" aria-label="Aperçu du site en style terminal">
        <div class="terminal-bar" aria-hidden="true">
          <span></span><span></span><span></span>
          <span class="ml-2 text-fg-subtle">jeremie@vitet.info — zsh</span>
        </div>
        <pre class="terminal-body"><span class="prompt">$</span> ls -la ~/vitet.info
<a href="/docs">docs/</a>      <span class="dim">{String(counts.docs).padStart(3)} fiches</span><span class="hidden sm:inline">   base de connaissances</span>
<a href="/blog">blog/</a>      <span class="dim">{String(counts.blog).padStart(3)} billets</span><span class="hidden sm:inline">  humeur, veille, retex</span>
<a href="/lab">lab/</a>       <span class="dim">{String(counts.lab).padStart(3)} projets</span><span class="hidden sm:inline">  homelab &amp; bricolages</span>
<a href="/voyages">voyages/</a>   <span class="dim">{String(counts.voyages).padStart(3)} carnets</span><span class="hidden sm:inline">  japon, transports, geekeries</span>
<span class="prompt">$</span> uptime
 15 ans dans l'IT<span class="hidden sm:inline">, load average: infra, réseau, cloud</span>
<span class="prompt">$</span> whoami
 DSI qui garde les mains dans la console<span class="cursor" aria-hidden="true"></span></pre>
      </div>
    </div>
  </section>

  <div class="container-x flex flex-col gap-20 py-16">
    {/* ---------------------------------------------------- 1. Derniers contenus */}
    <section aria-labelledby="latest">
      <SectionHeading id="latest" eyebrow="// fraîchement publié" title="Derniers contenus" />
      <CardGrid items={latest} showSection />
    </section>

    {/* ------------------------------------------------ 2. Documentation populaire */}
    <section aria-labelledby="popular" class="hue-docs">
      <SectionHeading id="popular" eyebrow="// docs" title="Documentation populaire" href="/docs" linkLabel="Toute la doc" />
      <ol class="grid gap-x-8 md:grid-cols-2" role="list">
        {
          popularDocs.map((doc, i) => (
            <li class="flex gap-4 border-b border-line py-4">
              <span class="font-mono text-sm text-fg-subtle tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <div class="min-w-0 flex-1">
                <p class="eyebrow text-docs">{doc.categoryLabel}</p>
                <a href={doc.href} class="mt-0.5 block font-display text-[1.0625rem] font-semibold leading-snug hover:text-docs">
                  {doc.title}
                </a>
                <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-fg-subtle">
                  {doc.level && <LevelBadge level={doc.level} />}
                  <span>{doc.readingMinutes} min</span>
                  {doc.tested && (
                    <span class="inline-flex items-center gap-1 text-lab">
                      <Icon name="check-circle" size={13} /> testé
                    </span>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* ------------------------------------------------ 3. Catégories techniques */}
    <section aria-labelledby="categories" class="hue-docs">
      <SectionHeading id="categories" eyebrow="// par domaine" title="Catégories techniques" />
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" role="list">
        {
          categories.map((c) => (
            <li>
              <a href={c.href} class="card group h-full no-underline">
                <span class="flex items-center justify-between">
                  <span class="font-mono text-xs text-docs">{c.short}</span>
                  <span class="font-mono text-xs text-fg-subtle">{c.count} fiche{c.count > 1 ? 's' : ''}</span>
                </span>
                <span class="font-display font-semibold text-fg group-hover:text-docs">{c.label}</span>
                <span class="text-sm text-fg-muted">{c.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ------------------------------------------------------- 4. Lab */}
    <section aria-labelledby="lab" class="hue-lab">
      <SectionHeading id="lab" eyebrow="// homelab & bricolages" title="Derniers projets du Lab" href="/lab" linkLabel="Tout le lab" />
      <CardGrid items={latestLab} />
    </section>

    {/* ------------------------------------------------------- 5. Blog */}
    <section aria-labelledby="posts" class="hue-blog">
      <SectionHeading id="posts" eyebrow="// blog" title="Derniers billets" href="/blog" linkLabel="Tous les billets" />
      <div class="grid gap-x-10 md:grid-cols-2">
        {latestPosts.map((post) => <Card item={post} variant="row" headingLevel="h3" />)}
      </div>
    </section>

    {/* ---------------------------------------------------- 6. Voyages */}
    <section aria-labelledby="travel" class="hue-travel">
      <SectionHeading id="travel" eyebrow="// carnet" title="Contenu voyage récent" href="/voyages" linkLabel="Tous les carnets" />
      <CardGrid items={latestTravel} variant="cover" columns={2} />
    </section>

    {/* ------------------------------------------------- 7. Présentation */}
    <section aria-labelledby="about" class="grid gap-8 rounded-lg border border-line bg-bg-elev p-6 md:grid-cols-[auto_1fr] md:p-10">
      <div class="font-mono text-sm leading-relaxed text-fg-subtle" aria-hidden="true">
        <pre class="whitespace-pre">┌─ whoami ──────────┐
│ DSI, PME indus.   │
│ 15 ans de terrain │
│ Japon au cœur     │
│ homelab en cave   │
└───────────────────┘</pre>
      </div>
      <div>
        <h2 id="about" class="font-display text-2xl font-bold tracking-tight">Un DSI qui garde les mains dans la console</h2>
        <p class="mt-3 max-w-2xl text-fg-muted text-pretty">
          Je pilote l'informatique d'une PME industrielle et je continue à faire moi-même : réseaux, serveurs,
          Microsoft 365, sécurité, self-hosting. Ce site regroupe ce que j'ai appris sur le terrain, sans langue de
          bois ni PowerPoint, avec parfois une pointe de mauvaise foi.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/a-propos" class="btn">À propos</a>
          <a href="/cv" class="btn">Mon parcours</a>
          <a href={SITE.author.github} class="btn" rel="me noopener"><Icon name="github" size={16} /> GitHub</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .terminal {
    border: 1px solid var(--c-line);
    border-radius: 0.75rem;
    background: var(--c-bg-elev);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--c-line);
    background: var(--c-bg-muted);
    font-size: 0.75rem;
  }
  .terminal-bar > span:nth-child(-n + 3) {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--c-line-strong);
  }
  .terminal-body {
    margin: 0;
    padding: 1rem 1.1rem 1.1rem;
    line-height: 1.7;
    overflow-x: auto;
    color: var(--c-fg);
  }
  .terminal-body a {
    color: var(--c-accent);
    text-decoration: none;
    font-weight: 600;
  }
  .terminal-body a:hover {
    text-decoration: underline;
  }
  .prompt {
    color: var(--c-lab);
    font-weight: 600;
  }
  .dim {
    color: var(--c-fg-subtle);
  }
</style>
