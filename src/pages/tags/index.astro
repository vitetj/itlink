---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getTagIndex } from '@/lib/content';

const tags = await getTagIndex();
const max = Math.max(1, ...tags.map((t) => t.count));
/**
 * Au-delà de deux occurrences, un tag est un vrai sujet de fond ; en dessous,
 * c'est de la longue traîne, utile en recherche mais illisible en nuage. Elle est
 * donc repliée : la page reste scannable sans rien rendre inaccessible.
 */
const main = tags.filter((t) => t.count >= 3);
const tail = tags.filter((t) => t.count < 3).sort((a, b) => a.tag.localeCompare(b.tag, 'fr'));
---

<BaseLayout seo={{ title: 'Tags', description: 'Tous les sujets abordés sur le site, docs, blog, lab et voyages confondus.', image: '/og/tags.png' }}>
  <div class="container-x py-10 md:py-14">
    <SectionHeading level="h1" eyebrow="index" title={`${tags.length} tags`} />
    <p class="max-w-(--measure) text-fg-muted">
      Les sujets qui reviennent en premier, les plus pointus ensuite. Pour chercher dans le texte des articles,
      passez plutôt par <a href="/recherche" class="link">la recherche</a>.
    </p>

    <h2 class="eyebrow mt-8">Sujets principaux</h2>
    <ul class="mt-3 flex flex-wrap gap-2" role="list">
      {
        main.map((t) => (
          <li>
            <a href={`/tags/${t.slug}/`} class="tag" style={`font-size:${(0.8 + (t.count / max) * 0.4).toFixed(2)}rem`}>
              #{t.tag} <span class="text-fg-subtle">{t.count}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <details class="mt-10 border-t border-line pt-4">
      <summary class="cursor-pointer font-mono text-sm text-fg-muted hover:text-fg">
        et {tail.length} sujets plus pointus, par ordre alphabétique
      </summary>
      <ul class="mt-4 flex flex-wrap gap-2" role="list">
        {
          tail.map((t) => (
            <li>
              <a href={`/tags/${t.slug}/`} class="tag text-xs">
                #{t.tag} <span class="text-fg-subtle">{t.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</BaseLayout>
