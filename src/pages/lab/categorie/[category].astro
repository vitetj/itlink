---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CardGrid from '@/components/CardGrid.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { LAB_CATEGORIES } from '@/data/site';
import { getLab, labToCard } from '@/lib/content';

export const getStaticPaths = (async () => {
  const items = await getLab();
  return LAB_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category, items: items.filter((p) => p.data.category === category.slug).map(labToCard) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { category, items } = Astro.props;
---

<BaseLayout seo={{ title: `${category.label} — Lab`, description: `Projets et expérimentations « ${category.label} ».`, image: '/og/lab.png' }} hue="lab">
  <div class="container-x py-10 md:py-14">
    <SectionHeading level="h1" eyebrow="lab · catégorie" title={category.label} href="/lab/" linkLabel="Tout le lab" />
    {items.length > 0 ? <CardGrid items={items} headingLevel="h2" /> : <p class="text-fg-muted">Rien encore ici. Le matériel est commandé, promis.</p>}
  </div>
</BaseLayout>
