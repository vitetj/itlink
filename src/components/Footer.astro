---
import { SECTIONS, SITE } from '@/data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const feeds = [
  { href: '/rss.xml', label: 'Tout le site' },
  { href: '/docs/rss.xml', label: 'Docs' },
  { href: '/blog/rss.xml', label: 'Blog' },
  { href: '/lab/rss.xml', label: 'Lab' },
  { href: '/voyages/rss.xml', label: 'Voyages' },
];
---

<footer class="mt-24 border-t border-line bg-bg-elev no-print">
  <div class="container-x grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-md">
      <p class="font-display text-lg font-bold">{SITE.name}</p>
      <p class="mt-1 eyebrow">{SITE.author.role}</p>
      <p class="mt-4 text-[0.9375rem] text-fg-muted">
        Notes de terrain d'un DSI qui aime encore les consoles, les VLAN mal étiquetés et les redémarrages du
        vendredi soir. Tout ce qui est publié ici a servi au moins une fois pour de vrai.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        <li>
          <a href={SITE.author.github} class="tag" rel="me noopener"><Icon name="github" size={14} /> GitHub</a>
        </li>
        <li>
          <a href={SITE.author.linkedin} class="tag" rel="me noopener"><Icon name="linkedin" size={14} /> LinkedIn</a>
        </li>
        <li>
          <a href={`mailto:${SITE.author.email}`} class="tag"><Icon name="mail" size={14} /> {SITE.author.email}</a>
        </li>
      </ul>
    </div>

    <nav aria-label="Sections du site">
      <p class="eyebrow">Sections</p>
      <ul class="mt-3 flex flex-col gap-2 text-[0.9375rem]">
        {
          Object.values(SECTIONS).map((s) => (
            <li>
              <a href={s.href} class="link">
                {s.label}
              </a>
              <span class="text-fg-subtle"> — {s.tagline}</span>
            </li>
          ))
        }
        <li><a href="/a-propos" class="link">À propos</a></li>
        <li><a href="/cv" class="link">CV</a></li>
        <li><a href="/tags" class="link">Tous les tags</a></li>
        <li><a href="/recherche" class="link">Recherche</a></li>
      </ul>
    </nav>

    <div>
      <p class="eyebrow">Flux RSS</p>
      <ul class="mt-3 flex flex-col gap-2 text-[0.9375rem]">
        {
          feeds.map((f) => (
            <li>
              <a href={f.href} class="link inline-flex items-center gap-1.5">
                <Icon name="rss" size={14} /> {f.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 eyebrow">Sous le capot</p>
      <p class="mt-2 font-mono text-xs text-fg-subtle">
        Astro · Starlight · Tailwind · Pagefind<br />
        Site statique, sans base de données, sans traqueur.<br />
        <a href="/sitemap-index.xml" class="link">Sitemap</a>
      </p>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-wrap items-center justify-between gap-2 py-4 font-mono text-xs text-fg-subtle">
      <span>© {SITE.since}–{year} {SITE.name}</span>
      <span aria-hidden="true">$ echo "merci d'être passé" && exit 0</span>
    </div>
  </div>
</footer>
