---
/**
 * Schéma du homelab en SVG inline, aux couleurs du thème (variables CSS).
 * Données dans `NODES` / `LINKS` : modifier ici pour faire évoluer le schéma.
 */
interface Node {
  id: string;
  label: string;
  sub: string;
  x: number;
  y: number;
  w?: number;
  tone?: 'lab' | 'docs' | 'blog' | 'travel' | 'muted';
}

const NODES: Node[] = [
  { id: 'wan', label: 'Fibre FTTH', sub: 'box opérateur', x: 40, y: 30, tone: 'muted' },
  { id: 'udm', label: 'UniFi UDM Pro', sub: 'routeur, VLAN, IDS/IPS', x: 40, y: 130, tone: 'docs' },
  { id: 'sw', label: 'Switch UniFi', sub: 'PoE, 10 GbE vers les nœuds', x: 40, y: 230, tone: 'docs' },
  { id: 'pve1', label: 'Proxmox nœud 1', sub: 'Dell PowerEdge', x: 300, y: 80, tone: 'lab' },
  { id: 'pve2', label: 'Proxmox nœud 2', sub: 'Dell PowerEdge', x: 300, y: 180, tone: 'lab' },
  { id: 'pve3', label: 'Proxmox nœud 3', sub: 'Dell PowerEdge', x: 300, y: 280, tone: 'lab' },
  { id: 'ceph', label: 'Ceph', sub: 'stockage distribué HCI', x: 560, y: 130, tone: 'blog' },
  { id: 'san', label: 'SAN EqualLogic', sub: 'iSCSI multipath', x: 560, y: 230, tone: 'blog' },
  { id: 'bkp', label: 'Serveur de sauvegarde', sub: 'indépendant du cluster', x: 820, y: 130, tone: 'travel' },
  { id: 'nas', label: 'TrueNAS SCALE', sub: 'ZFS immuable, DMZ', x: 820, y: 230, tone: 'travel' },
  { id: 'cloud', label: 'Réplication cloud', sub: 'copie hors site', x: 820, y: 330, tone: 'muted' },
];

const LINKS: [string, string][] = [
  ['wan', 'udm'],
  ['udm', 'sw'],
  ['sw', 'pve1'],
  ['sw', 'pve2'],
  ['sw', 'pve3'],
  ['pve1', 'ceph'],
  ['pve2', 'ceph'],
  ['pve3', 'ceph'],
  ['pve2', 'san'],
  ['ceph', 'bkp'],
  ['bkp', 'nas'],
  ['nas', 'cloud'],
];

const W = 200;
const H = 56;
const byId = Object.fromEntries(NODES.map((n) => [n.id, n]));
const center = (n: Node) => ({ cx: n.x + (n.w ?? W) / 2, cy: n.y + H / 2 });
const tones: Record<string, string> = {
  lab: 'var(--c-lab)',
  docs: 'var(--c-docs)',
  blog: 'var(--c-blog)',
  travel: 'var(--c-travel)',
  muted: 'var(--c-fg-subtle)',
};
---

<figure class="infra">
  <svg viewBox="0 0 1060 420" role="img" aria-labelledby="infra-title infra-desc" class="w-full h-auto">
    <title id="infra-title">Schéma du homelab</title>
    <desc id="infra-desc">
      Une fibre alimente un routeur UniFi Dream Machine Pro puis un switch, reliés à trois nœuds Proxmox Dell PowerEdge.
      Les nœuds partagent un stockage Ceph et une baie SAN EqualLogic. Un serveur de sauvegarde indépendant capture les
      données, un TrueNAS SCALE en DMZ assure l'immutabilité et réplique vers le cloud.
    </desc>
    <g stroke="var(--c-line-strong)" stroke-width="1.5" fill="none">
      {
        LINKS.map(([a, b]) => {
          const na = byId[a];
          const nb = byId[b];
          if (!na || !nb) return null;
          const A = center(na);
          const B = center(nb);
          const sameColumn = Math.abs(A.cx - B.cx) < 1;
          const d = sameColumn
            ? `M${A.cx},${A.cy + H / 2} L${B.cx},${B.cy - H / 2}`
            : `M${na.x + W},${A.cy} C${na.x + W + 40},${A.cy} ${nb.x - 40},${B.cy} ${nb.x},${B.cy}`;
          return <path d={d} />;
        })
      }
    </g>
    {
      NODES.map((n) => (
        <g transform={`translate(${n.x},${n.y})`}>
          <rect width={n.w ?? W} height={H} rx="6" fill="var(--c-bg-elev)" stroke="var(--c-line)" />
          <rect width="4" height={H} rx="2" fill={tones[n.tone ?? 'muted']} />
          <text x="16" y="23" font-family="var(--font-display)" font-weight="600" font-size="15" fill="var(--c-fg)">
            {n.label}
          </text>
          <text x="16" y="42" font-family="var(--font-mono)" font-size="11" fill="var(--c-fg-muted)">
            {n.sub}
          </text>
        </g>
      ))
    }
  </svg>
  <figcaption class="mt-2 font-mono text-xs text-fg-subtle">
    Le homelab en un coup d'œil : réseau, calcul, stockage et sauvegarde sont volontairement séparés.
  </figcaption>
</figure>

<style>
  .infra {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--c-line);
    border-radius: 0.5rem;
    background: var(--c-bg);
    overflow-x: auto;
  }
  .infra svg {
    min-width: 640px;
  }
</style>
