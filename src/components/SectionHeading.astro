---
/** Titre de section d'une page de liste ou d'accueil : surtitre mono + titre + lien « voir tout ». */
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string | undefined;
  title: string;
  href?: string | undefined;
  linkLabel?: string | undefined;
  level?: 'h1' | 'h2' | 'h3';
  id?: string | undefined;
}

const { eyebrow, title, href, linkLabel = 'Tout voir', level: Tag = 'h2', id } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
  <div>
    {eyebrow && <p class="eyebrow text-hue">{eyebrow}</p>}
    <Tag id={id} class="mt-1 font-display text-2xl font-bold tracking-tight md:text-[1.75rem]">{title}</Tag>
  </div>
  {
    href && (
      <a href={href} class="inline-flex items-center gap-1 font-mono text-sm text-fg-muted hover:text-fg">
        {linkLabel} <Icon name="arrow-right" size={16} />
      </a>
    )
  }
</div>
