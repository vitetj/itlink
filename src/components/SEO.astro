---
/**
 * Balises meta, OpenGraph, Twitter Cards et canonical.
 * L'image OpenGraph par défaut est générée par la route `/og/[...slug].png`.
 */
import { SITE } from '@/data/site';
import { absoluteUrl, ogImagePath, pageTitle, type SeoInput } from '@/lib/seo';

type Props = SeoInput;

const {
  title,
  description,
  canonical,
  type = 'website',
  image,
  imageAlt,
  published,
  updated,
  tags,
  section,
  noindex,
} = Astro.props;

const canonicalUrl = absoluteUrl(canonical ?? Astro.url.pathname);
const ogImage = absoluteUrl(image ?? ogImagePath(Astro.url.pathname));
const fullTitle = pageTitle(title);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={SITE.author.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? title} />
{type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
{type === 'article' && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' && tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? title} />
