---
/**
 * Cadre de page de la documentation, sans barre latérale.
 *
 * Starlight place ici une colonne de navigation à gauche. On la remplace par un
 * bandeau horizontal de domaines sous l'en-tête : le contenu occupe toute la
 * largeur et le sommaire de la page reste à droite. Le slot `sidebar` fourni par
 * Starlight n'est volontairement pas rendu.
 */
import DocsCategoryBar from './DocsCategoryBar.astro';
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  <DocsCategoryBar />
  <div class="main-frame"><slot /></div>
</div>

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    z-index: var(--sl-z-index-navbar);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--sl-nav-height);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
  }

  .main-frame {
    padding-top: calc(var(--sl-nav-height) + var(--docs-bar-h) + var(--sl-mobile-toc-height));
  }
</style>
