---
/**
 * Cadre de page de la documentation.
 *
 * Reprend celui de Starlight en ajoutant un bouton de repli : sur grand écran,
 * la barre latérale se rétracte et le contenu occupe toute la largeur. Le choix
 * est mémorisé par le navigateur et réappliqué avant le premier rendu (voir le
 * script en ligne de `Head.astro`), pour éviter que la page saute au chargement.
 */
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import Icon from '@/components/Icon.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <script>
          // Le menu mobile s'ouvre via l'API popover ; on y ajoute le piégeage du focus.
          class StarlightSidebarPane extends HTMLElement {
            constructor() {
              super();
              matchMedia('(min-width: 50em)').addEventListener('change', () => this.hidePopover());
              this.addEventListener('toggle', ({ newState }) => this.trapFocus(newState === 'open'));
            }
            trapFocus(shouldTrap: boolean) {
              document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => {
                el.toggleAttribute('inert', shouldTrap);
              });
            }
          }
          customElements.define('sl-sidebar-pane', StarlightSidebarPane);
        </script>
        <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </sl-sidebar-pane>
      </nav>
    )
  }
  {
    hasSidebar && (
      <button
        type="button"
        class="sidebar-toggle print:hidden"
        data-sidebar-toggle
        aria-controls="starlight__sidebar"
        aria-expanded="true"
      >
        <Icon name="chevron-left" size={16} />
        <span class="sr-only" data-sidebar-toggle-label>
          Replier le sommaire
        </span>
      </button>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<script>
  /**
   * Replie ou déplie la barre latérale et mémorise le choix.
   * Sans JavaScript le bouton n'apparaît pas et la barre reste affichée.
   */
  const KEY = 'docs-sidebar-collapsed';
  const apply = (collapsed: boolean) => {
    document.documentElement.toggleAttribute('data-sidebar-collapsed', collapsed);
    document.querySelectorAll('[data-sidebar-toggle]').forEach((button) => {
      button.setAttribute('aria-expanded', String(!collapsed));
      const label = button.querySelector('[data-sidebar-toggle-label]');
      if (label) label.textContent = collapsed ? 'Déplier le sommaire' : 'Replier le sommaire';
    });
  };
  document.querySelectorAll('[data-sidebar-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const collapsed = !document.documentElement.hasAttribute('data-sidebar-collapsed');
      try {
        localStorage.setItem(KEY, collapsed ? '1' : '0');
      } catch {
        /* navigation privée : on se contente de la session en cours */
      }
      apply(collapsed);
    });
  });
  apply(document.documentElement.hasAttribute('data-sidebar-collapsed'));
</script>

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    z-index: var(--sl-z-index-navbar);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--sl-nav-height);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    padding-inline-end: var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
  }

  :global([data-has-sidebar]) .header {
    padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
  }

  .sidebar-pane {
    border: unset;
    padding: unset;
    height: unset;
    color: unset;

    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: var(--sl-color-black);
    overflow-y: auto;
    scrollbar-gutter: stable;
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 1rem var(--sl-sidebar-pad-x) 0;
    flex-direction: column;
    gap: 1rem;
  }

  .main-frame {
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    padding-inline-start: var(--sl-content-inline-start);
  }

  /* Le bouton de repli n'a de sens que là où la barre est réellement affichée. */
  .sidebar-toggle {
    display: none;
  }

  @media (min-width: 50rem) {
    .sidebar-content::after {
      content: '';
      padding-bottom: 1px;
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: var(--sl-nav-pad-x);
    }

    .sidebar-pane {
      display: block;
      width: var(--sl-sidebar-width);
      background-color: var(--sl-color-bg-sidebar);
      border-inline-end: 1px solid var(--sl-color-hairline-shade);
    }

    .sidebar-toggle {
      position: fixed;
      z-index: calc(var(--sl-z-index-navbar) - 1);
      top: calc(var(--sl-nav-height) + 0.75rem);
      inset-inline-start: calc(var(--sl-content-inline-start) + 0.5rem);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      border: 0;
      border-radius: var(--r-pill);
      background: transparent;
      color: var(--c-fg-subtle);
      cursor: pointer;
      transition: background-color 160ms ease, color 160ms ease, inset-inline-start 160ms ease;
    }
    .sidebar-toggle:hover {
      background: var(--c-bg-muted);
      color: var(--c-fg);
    }
    :global([data-sidebar-collapsed]) .sidebar-toggle :global(svg) {
      transform: scaleX(-1);
    }
  }
</style>
