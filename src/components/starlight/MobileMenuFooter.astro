---
/** Pied du menu latéral mobile de Starlight : liens du site, thème et réseaux. */
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import { NAV } from '@/data/site';
import ThemeToggle from '@/components/ThemeToggle.astro';
---

<nav aria-label="Autres sections du site" class="mt-4 border-t border-line pt-4">
  <p class="eyebrow mb-2">Le site</p>
  <ul class="flex flex-col">
    {
      NAV.map((item) => (
        <li>
          <a href={item.href} class="block rounded px-2 py-1.5 font-medium text-fg no-underline hover:bg-bg-muted">
            {item.label}
          </a>
        </li>
      ))
    }
    <li><a href="/cv" class="block rounded px-2 py-1.5 font-medium text-fg no-underline hover:bg-bg-muted">CV</a></li>
  </ul>
</nav>
<div class="mt-4 flex items-center justify-between border-t border-line pt-4">
  <div class="flex items-center gap-3"><SocialIcons /></div>
  <ThemeToggle />
</div>
