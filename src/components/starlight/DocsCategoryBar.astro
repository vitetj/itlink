---
/**
 * Bandeau horizontal des domaines de la documentation, sous l'en-tête.
 * Remplace la barre latérale : la navigation fine se fait ensuite sur la page
 * de catégorie, qui liste ses fiches groupées par niveau.
 */
import { DOC_CATEGORIES } from '@/data/site';

const path = Astro.url.pathname.replace(/\/$/, '');
const isOverview = path === '/docs';
/** Les libellés à rallonge (« Microsoft 365 / Entra ») sont coupés avant la barre oblique. */
const navLabel = (label: string) => label.split(' / ')[0] ?? label;
---

<docs-bar class="docs-bar">
  <nav class="docs-bar-inner" aria-label="Domaines de la documentation">
    <a href="/docs" class="docs-bar-link" aria-current={isOverview ? 'page' : undefined}>
      Vue d'ensemble
    </a>
    {
      DOC_CATEGORIES.map((category) => {
        const href = `/docs/${category.slug}`;
        const active = path === href || path.startsWith(`${href}/`);
        return (
          <a href={href} class="docs-bar-link" aria-current={active ? 'page' : undefined}>
            {navLabel(category.label)}
          </a>
        );
      })
    }
  </nav>
</docs-bar>

<script>
  /**
   * Signale par un dégradé que le bandeau défile encore, d'un côté ou de l'autre.
   * Sans JavaScript le bandeau reste défilable, simplement sans cet indice.
   */
  class DocsBar extends HTMLElement {
    connectedCallback() {
      const rail = this.querySelector('.docs-bar-inner');
      if (!(rail instanceof HTMLElement)) return;
      const update = () => {
        const start = rail.scrollLeft > 4;
        const end = rail.scrollLeft + rail.clientWidth < rail.scrollWidth - 4;
        this.dataset.overflow = start && end ? 'both' : start ? 'start' : end ? 'end' : 'none';
      };
      rail.addEventListener('scroll', update, { passive: true });
      new ResizeObserver(update).observe(rail);
      update();
      // Amène le domaine courant dans le champ de vision.
      const current = rail.querySelector('[aria-current="page"]');
      if (current instanceof HTMLElement) {
        rail.scrollLeft = Math.max(0, current.offsetLeft - rail.clientWidth / 2 + current.offsetWidth / 2);
      }
    }
  }
  customElements.define('docs-bar', DocsBar);
</script>

<style>
  .docs-bar {
    display: block;
    position: fixed;
    inset-inline: 0;
    top: var(--sl-nav-height);
    z-index: calc(var(--sl-z-index-navbar) - 1);
    height: var(--docs-bar-h);
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }
  .docs-bar-inner {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    height: 100%;
    padding-inline: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .docs-bar-inner::-webkit-scrollbar {
    display: none;
  }
  .docs-bar[data-overflow='end'] .docs-bar-inner {
    mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
  }
  .docs-bar[data-overflow='start'] .docs-bar-inner {
    mask-image: linear-gradient(to left, #000 calc(100% - 3rem), transparent);
  }
  .docs-bar[data-overflow='both'] .docs-bar-inner {
    mask-image: linear-gradient(to right, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
  }
  @media (min-width: 50rem) {
    .docs-bar-inner {
      padding-inline: 1.5rem;
    }
  }
  .docs-bar-link {
    flex: none;
    padding: 0.35rem 0.55rem;
    border-radius: var(--r-pill);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--c-fg-muted);
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .docs-bar-link:hover {
    background: var(--c-bg-muted);
    color: var(--c-fg);
  }
  .docs-bar-link[aria-current='page'] {
    background: var(--c-docs-soft);
    color: var(--c-docs);
  }
</style>
