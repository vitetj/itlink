---
/** Indique qu'une procédure a réellement été déroulée, avec la liste des environnements. */
import Icon from './Icon.astro';

interface Props {
  testedOn?: string[] | undefined;
  tested?: boolean | undefined;
  class?: string;
}

const { testedOn = [], tested, class: className } = Astro.props;
const isTested = tested ?? testedOn.length > 0;
---

{
  isTested && (
    <span class:list={['inline-flex items-center gap-1.5 font-mono text-xs text-lab', className]}>
      <Icon name="check-circle" size={14} />
      <span>Testé{testedOn.length > 0 && ` sur ${testedOn.join(', ')}`}</span>
    </span>
  )
}
